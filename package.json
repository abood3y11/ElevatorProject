{
  "name": "elevator-management-system",
  "version": "1.0.0",
  "description": "Elevator Lifecycle Management System (ELMS) - Comprehensive elevator management with client, admin, and worker portals",
  "private": true,
  "scripts": {
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "setup:windows": ".\\ELMS-Setup-Local-Windows.cmd",
    "start:windows": ".\\ELMS-Launcher.cmd",
    "build:launcher:windows": "powershell -ExecutionPolicy Bypass -File scripts\\windows\\build-elms-launcher.ps1"
  },
  "keywords": [
    "elevator",
    "management",
    "maintenance",
    "installation",
    "SASO",
    "SBC"
  ],
  "author": "Elevator Management Team",
  "license": "MIT"
}
